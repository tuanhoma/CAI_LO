# ==============================================================================
# CAI (CyberAI Pentesting Framework) - Environment Configuration
# Copy this file to .env:
#   Windows (CMD): copy .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS: cp .env.example .env
# ==============================================================================

# [Option 1] Local Ollama (Free, Private, Offline - Recommended for Local Security Labs)
# Make sure Ollama is installed and running:
#   ollama run qwen2.5-coder:14b  (or qwen2.5-coder:7b)
CAI_MODEL="ollama/qwen2.5-coder:14b"
OLLAMA_HOST="http://localhost:11434"
OLLAMA_API_BASE="http://localhost:11434"

# [Option 2] Google Gemini (High speed & Free tier via Google AI Studio)
# Get your API key at: https://aistudio.google.com/
# Uncomment below if using Gemini:
# CAI_MODEL="gemini/gemini-2.5-flash"
GEMINI_API_KEY=""

# [Option 3] Other Cloud Providers (Optional)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ==============================================================================
# Core Engine & Security Settings
# ==============================================================================
PROMPT_TOOLKIT_NO_CPR=1
CAI_STREAM=false

# Allow scanning/testing internal networks and localhost (required for CTF / local targets)
CAI_FETCH_ALLOW_INTERNAL=true